-- ============================================================================

local function main()
    -- Create pipeline
    local pipeline = ExecutionPipeline.new(CONFIG)
    
    -- Create cleanup handler
    local cleanup = CleanupHandler.new(pipeline)
    
    -- Register cleanup tasks
    cleanup:registerCleanupTask("Clear HTTP cache", function()
        pipeline.httpHandler:clearCache()
    end, 10)
    
    cleanup:registerCleanupTask("Clear error history", function()
        pipeline.errorHandler:clearErrors()
    end, 20)
    
    cleanup:registerCleanupTask("Reset timer manager", function()
        pipeline.timerManager:reset()
    end, 30)
    
    cleanup:registerCleanupTask("Clear execution history", function()
        pipeline.scriptExecutor:clearHistory()
    end, 40)
    
    cleanup:registerCleanupTask("Reset performance monitor", function()
        pipeline.performanceMonitor:reset()
    end, 50)
    
    -- Run the pipeline
    local success, result = pcall(function()
        return pipeline:run()
    end)
    
    if not success then
        pipeline.logger:error("Pipeline failed with error: " .. tostring(result))
    end
    
    -- Execute cleanup
    cleanup:execute()
    
    -- Final grace period
    if CONFIG.TIMING.GRACEFUL_SHUTDOWN_DELAY > 0 then
        task.wait(CONFIG.TIMING.GRACEFUL_SHUTDOWN_DELAY)
    end
    
    return success, result
end

-- ============================================================================
-- EXECUTE MAIN FUNCTION
-- ============================================================================

local executionSuccess, executionResult = main()

-- Return result for external access if needed
return {
    success = executionSuccess,
    result = executionResult,
    timestamp = Utilities.getFormattedTimestamp()
}
