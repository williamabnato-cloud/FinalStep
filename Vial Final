local Logger = {}
Logger.__index = Logger

Logger.LEVELS = {
    DEBUG = 1,
    INFO = 2,
    WARNING = 3,
    ERROR = 4,
    CRITICAL = 5,
    NONE = 6
}

Logger.COLORS = {
    DEBUG = "gray",
    INFO = "cyan",
    WARNING = "yellow",
    ERROR = "red",
    CRITICAL = "magenta"
}

function Logger.new(config)
    local self = setmetatable({}, Logger)
    
    self.enabled = config.ENABLED or true
    self.level = Logger.LEVELS[config.LOG_LEVEL] or Logger.LEVELS.INFO
    self.logToConsole = config.LOG_TO_CONSOLE or true
    self.logToFile = config.LOG_TO_FILE or false
    self.showTimestamp = config.LOG_TIMESTAMP or true
    self.prefix = config.LOG_PREFIX or "[EclipseLoader]"
    self.colorize = config.COLORIZE_OUTPUT or false
    self.verbose = config.VERBOSE_MODE or false
    self.entries = {}
    self.startTime = tick()
    
    return self
end

function Logger:shouldLog(level)
    if not self.enabled then
        return false
    end
    return Logger.LEVELS[level] >= self.level
end

function Logger:formatMessage(level, message, ...)
    local formatted = ""
    
    if self.showTimestamp then
        formatted = formatted .. "[" .. Utilities.getFormattedTimestamp() .. "] "
    end
    
    formatted = formatted .. self.prefix .. " "
    formatted = formatted .. "[" .. level .. "] "
    formatted = formatted .. tostring(message)
    
    local args = {...}
    if #args > 0 then
        local argStrings = {}
        for i, arg in ipairs(args) do
            table.insert(argStrings, tostring(arg))
        end
        formatted = formatted .. " | " .. table.concat(argStrings, ", ")
    end
    
    return formatted
end

function Logger:log(level, message, ...)
    if not self:shouldLog(level) then
        return
    end
    
    local formatted = self:formatMessage(level, message, ...)
    
    table.insert(self.entries, {
        level = level,
        message = formatted,
        timestamp = tick(),
        rawMessage = message
    })
    
    if self.logToConsole then
        if self.colorize then
            -- Color output if supported
            local color = Logger.COLORS[level] or "white"
            print(formatted)
        else
            print(formatted)
        end
    end
end

function Logger:debug(message, ...)
    self:log("DEBUG", message, ...)
end

function Logger:info(message, ...)
    self:log("INFO", message, ...)
end

function Logger:warning(message, ...)
    self:log("WARNING", message, ...)
end

function Logger:error(message, ...)
    self:log("ERROR", message, ...)
end

function Logger:critical(message, ...)
    self:log("CRITICAL", message, ...)
end

function Logger:getEntries()
    return self.entries
end

function Logger:getEntryCount()
    return #self.entries
end

function Logger:getEntriesByLevel(level)
    local filtered = {}
    for _, entry in ipairs(self.entries) do
        if entry.level == level then
            table.insert(filtered, entry)
        end
    end
    return filtered
end

function Logger:clearEntries()
    self.entries = {}
end

function Logger:getUptime()
    return tick() - self.startTime
end

function Logger:generateReport()
    local report = {
        totalEntries = self:getEntryCount(),
        uptime = self:getUptime(),
        levelCounts = {}
    }
    
    for levelName, _ in pairs(Logger.LEVELS) do
        report.levelCounts[levelName] = #self:getEntriesByLevel(levelName)
    end
    
    return report
end

function Logger:setLevel(level)
    if Logger.LEVELS[level] then
        self.level = Logger.LEVELS[level]
    end
end

function Logger:enable()
    self.enabled = true
end

function Logger:disable()
    self.enabled = false
end

-- ============================================================================
-- SECTION 4: HTTP HANDLER MODULE
-- ============================================================================

local HttpHandler = {}
HttpHandler.__index = HttpHandler

function HttpHandler.new(logger, config)
    local self = setmetatable({}, HttpHandler)
    
    self.logger = logger
    self.config = config or {}
    self.cache = {}
    self.requestCount = 0
    self.totalBytesReceived = 0
    self.errors = {}
    self.isAvailable = false
    
    -- Check HTTP availability
    self:checkAvailability()
    
    return self
end

function HttpHandler:checkAvailability()
    self.logger:debug("Checking HTTP availability...")
    
    local success, result = pcall(function()
        return game and game.HttpGet and true or false
    end)
    
    if success and result then
        self.isAvailable = true
        self.logger:info("HTTP service available")
    else
        -- Try alternative check
        local altSuccess = pcall(function()
            game:HttpGet("https://httpbin.org/get")
            return true
        end)
        
        self.isAvailable = altSuccess
        if altSuccess then
            self.logger:info("HTTP service available (alternative check)")
        else
            self.logger:warning("HTTP service not available")
        end
    end
    
    return self.isAvailable
end

function HttpHandler:isHTTPAvailable()
    return self.isAvailable
end

function HttpHandler:validateURL(url)
    if Utilities.isStringEmpty(url) then
        self.logger:error("URL is empty or nil")
        return false, "URL is empty"
    end
    
    if not Utilities.isValidURL(url) then
        self.logger:error("Invalid URL format: " .. tostring(url))
        return false, "Invalid URL format"
    end
    
    -- Additional security checks
    if url:match("%.exe$") or url:match("%.bat$") then
        self.logger:error("Potentially dangerous URL detected")
        return false, "Dangerous file type"
    end
    
    return true, "Valid"
end

function HttpHandler:fetch(url, options)
    options = options or {}
    local timeout = options.timeout or self.config.TIMEOUT or 30
    local useCache = options.useCache or false
    local retries = options.retries or self.config.RETRY_COUNT or 3
    local retryDelay = options.retryDelay or self.config.RETRY_DELAY or 1
    
    self.logger:info("Fetching URL: " .. url)
    
    -- Validate URL
    local isValid, validationMessage = self:validateURL(url)
    if not isValid then
        self.logger:error("URL validation failed: " .. validationMessage)
        return false, nil, validationMessage
    end
    
    -- Check cache
    if useCache and self.cache[url] then
        self.logger:debug("Cache hit for URL: " .. url)
        return true, self.cache[url], "Cached"
    end
    
    -- Check HTTP availability
    if not self.isAvailable then
        self.logger:error("HTTP service not available")
        return false, nil, "HTTP unavailable"
    end
    
    -- Attempt fetch with retries
    local attemptCount = 0
    local lastError = nil
    
    while attemptCount < retries do
        attemptCount = attemptCount + 1
        
        self.logger:debug("Fetch attempt " .. attemptCount .. "/" .. retries)
        
        local success, result = pcall(function()
            return game:HttpGet(url, true)
        end)
        
        if success and result then
            self.requestCount = self.requestCount + 1
            self.totalBytesReceived = self.totalBytesReceived + #result
            
            -- Cache result if caching enabled
            if useCache then
                self.cache[url] = result
            end
            
            self.logger:info("Successfully fetched URL (attempt " .. attemptCount .. ")")
            self.logger:debug("Received " .. Utilities.formatBytes(#result) .. " of data")
            
            return true, result, "Success"
        else
            lastError = tostring(result)
            self.logger:warning("Fetch attempt " .. attemptCount .. " failed: " .. lastError)
            
            table.insert(self.errors, {
                url = url,
                attempt = attemptCount,
                error = lastError,
                timestamp = Utilities.getCurrentTimestamp()
            })
            
            if attemptCount < retries then
                local delay = retryDelay * (CONFIG.ERROR_HANDLING.RETRY_BACKOFF_MULTIPLIER ^ (attemptCount - 1))
                self.logger:debug("Waiting " .. delay .. "s before retry...")
                task.wait(delay)
            end
        end
    end
    
    self.logger:error("All fetch attempts failed for URL: " .. url)
    return false, nil, lastError
end

function HttpHandler:getStats()
    return {
        requestCount = self.requestCount,
        totalBytesReceived = self.totalBytesReceived,
        cacheSize = Utilities.getTableLength(self.cache),
        errorCount = #self.errors,
        isAvailable = self.isAvailable
    }
end

function HttpHandler:clearCache()
    self.cache = {}
    self.logger:debug("HTTP cache cleared")
end

function HttpHandler:getErrors()
    return self.errors
end

function HttpHandler:clearErrors()
    self.errors = {}
end

