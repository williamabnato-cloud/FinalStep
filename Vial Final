    self.errors = {}
    self.errorCount = 0
    self.recoveryStrategies = {}
    self.onErrorHandler = config.ERROR_CALLBACK
    
    self:registerDefaultStrategies()
    
    return self
end

function ErrorHandler:registerDefaultStrategies()
    -- Network error recovery
    self:registerRecoveryStrategy(ErrorHandler.ERROR_TYPES.NETWORK, function(error)
        self.logger:info("Attempting network error recovery...")
        task.wait(2)
        return true -- Retry
    end)
    
    -- Script error recovery
    self:registerRecoveryStrategy(ErrorHandler.ERROR_TYPES.SCRIPT, function(error)
        self.logger:info("Script error recovery - skipping...")
        return false -- Skip
    end)
    
    -- Compilation error recovery
    self:registerRecoveryStrategy(ErrorHandler.ERROR_TYPES.COMPILATION, function(error)
        self.logger:info("Compilation error - cannot recover")
        return false -- Skip
    end)
end

function ErrorHandler:registerRecoveryStrategy(errorType, strategy)
    self.recoveryStrategies[errorType] = strategy
    self.logger:debug("Recovery strategy registered for: " .. errorType)
end

function ErrorHandler:handleError(errorType, message, severity, context)
    severity = severity or ErrorHandler.SEVERITY.MEDIUM
    
    self.errorCount = self.errorCount + 1
    
    local errorRecord = {
        id = Utilities.generateUniqueId(),
        type = errorType,
        message = message,
        severity = severity,
        context = context,
        timestamp = Utilities.getFormattedTimestamp(),
        tickTimestamp = tick(),
        handled = false,
        recovered = false
    }
    
    table.insert(self.errors, errorRecord)
    
    -- Log based on severity
    if severity == ErrorHandler.SEVERITY.CRITICAL then
        self.logger:critical(message)
    elseif severity == ErrorHandler.SEVERITY.HIGH then
        self.logger:error(message)
    elseif severity == ErrorHandler.SEVERITY.MEDIUM then
        self.logger:warning(message)
    else
        self.logger:debug(message)
    end
    
    -- Call error handler if registered
    if self.onErrorHandler then
        pcall(self.onErrorHandler, errorRecord)
    end
    
    -- Attempt recovery
    local recovered = self:attemptRecovery(errorType, errorRecord)
    errorRecord.recovered = recovered
    errorRecord.handled = true
    
    return errorRecord
end

function ErrorHandler:attemptRecovery(errorType, errorRecord)
    local strategy = self.recoveryStrategies[errorType]
    
    if strategy then
        self.logger:debug("Attempting recovery for: " .. errorType)
        local success, shouldRetry = pcall(strategy, errorRecord)
        
        if success then
            return shouldRetry
        end
    end
    
    return false
end

function ErrorHandler:getErrors()
    return self.errors
end

function ErrorHandler:getErrorCount()
    return self.errorCount
end

function ErrorHandler:getErrorsByType(errorType)
    local filtered = {}
    for _, error in ipairs(self.errors) do
        if error.type == errorType then
            table.insert(filtered, error)
        end
    end
    return filtered
end

function ErrorHandler:getErrorsBySeverity(severity)
    local filtered = {}
    for _, error in ipairs(self.errors) do
        if error.severity == severity then
            table.insert(filtered, error)
        end
    end
    return filtered
end

function ErrorHandler:getRecoverableErrors()
    local filtered = {}
    for _, error in ipairs(self.errors) do
        if error.recovered then
            table.insert(filtered, error)
        end
    end
    return filtered
end

function ErrorHandler:clearErrors()
    self.errors = {}
    self.errorCount = 0
    self.logger:debug("Error history cleared")
end

function ErrorHandler:generateErrorReport()
    return {
        totalErrors = self.errorCount,
        byType = {
            NETWORK = #self:getErrorsByType(ErrorHandler.ERROR_TYPES.NETWORK),
            SCRIPT = #self:getErrorsByType(ErrorHandler.ERROR_TYPES.SCRIPT),
            COMPILATION = #self:getErrorsByType(ErrorHandler.ERROR_TYPES.COMPILATION),
            EXECUTION = #self:getErrorsByType(ErrorHandler.ERROR_TYPES.EXECUTION),
            VALIDATION = #self:getErrorsByType(ErrorHandler.ERROR_TYPES.VALIDATION),
            TIMEOUT = #self:getErrorsByType(ErrorHandler.ERROR_TYPES.TIMEOUT),
            UNKNOWN = #self:getErrorsByType(ErrorHandler.ERROR_TYPES.UNKNOWN)
        },
        bySeverity = {
            LOW = #self:getErrorsBySeverity(ErrorHandler.SEVERITY.LOW),
            MEDIUM = #self:getErrorsBySeverity(ErrorHandler.SEVERITY.MEDIUM),
            HIGH = #self:getErrorsBySeverity(ErrorHandler.SEVERITY.HIGH),
            CRITICAL = #self:getErrorsBySeverity(ErrorHandler.SEVERITY.CRITICAL)
        },
        recovered = #self:getRecoverableErrors()
    }
end

function ErrorHandler:hasCriticalErrors()
    return #self:getErrorsBySeverity(ErrorHandler.SEVERITY.CRITICAL) > 0
end

function ErrorHandler:throwIfCritical()
    if self:hasCriticalErrors() then
        local criticalErrors = self:getErrorsBySeverity(ErrorHandler.SEVERITY.CRITICAL)
        error("Critical errors detected: " .. #criticalErrors)
    end
end

-- ============================================================================
-- SECTION 8: PERFORMANCE MONITOR
-- ============================================================================

local PerformanceMonitor = {}
PerformanceMonitor.__index = PerformanceMonitor

function PerformanceMonitor.new(logger, config)
    local self = setmetatable({}, PerformanceMonitor)
    
    self.logger = logger
    self.config = config or {}
    self.enabled = config.MONITOR_ENABLED or false
    self.metrics = {
        startTime = tick(),
        endTime = nil,
        totalDuration = 0,
        scriptFetchTimes = {},
        scriptExecutionTimes = {},
        waitTimes = {},
        memorySnapshots = {},
        customMetrics = {}
    }
    
    return self
end

function PerformanceMonitor:start()
    if not self.enabled then return end
    
    self.metrics.startTime = tick()
    self.logger:debug("Performance monitoring started")
    
    if self.config.TRACK_MEMORY then
        self:takeMemorySnapshot("start")
    end
end

function PerformanceMonitor:stop()
    if not self.enabled then return end
    
    self.metrics.endTime = tick()
    self.metrics.totalDuration = self.metrics.endTime - self.metrics.startTime
    
    if self.config.TRACK_MEMORY then
        self:takeMemorySnapshot("end")
    end
    
    self.logger:debug("Performance monitoring stopped")
end

function PerformanceMonitor:recordFetchTime(url, duration)
    if not self.enabled or not self.config.TRACK_TIMING then return end
    
    table.insert(self.metrics.scriptFetchTimes, {
        url = url,
        duration = duration,
        timestamp = tick()
    })
end

function PerformanceMonitor:recordExecutionTime(scriptName, duration)
    if not self.enabled or not self.config.TRACK_TIMING then return end
    
    table.insert(self.metrics.scriptExecutionTimes, {
        scriptName = scriptName,
        duration = duration,
        timestamp = tick()
    })
end

function PerformanceMonitor:recordWaitTime(description, duration)
    if not self.enabled or not self.config.TRACK_TIMING then return end
    
    table.insert(self.metrics.waitTimes, {
        description = description,
        duration = duration,
        timestamp = tick()
    })
end

function PerformanceMonitor:takeMemorySnapshot(label)
    if not self.enabled or not self.config.TRACK_MEMORY then return end
    
    local memoryUsage = collectgarbage("count")
    
    table.insert(self.metrics.memorySnapshots, {
        label = label or "unnamed",
        memoryKB = memoryUsage,
        memoryMB = memoryUsage / 1024,
        timestamp = tick()
    })
    
    self.logger:debug("Memory snapshot '" .. label .. "': " .. Utilities.formatBytes(memoryUsage * 1024))
end

function PerformanceMonitor:recordCustomMetric(name, value)
    if not self.enabled then return end
    
    self.metrics.customMetrics[name] = {
        value = value,
        timestamp = tick()
    }
end

function PerformanceMonitor:getTotalFetchTime()
    local total = 0
    for _, record in ipairs(self.metrics.scriptFetchTimes) do
        total = total + record.duration
    end
    return total
end

function PerformanceMonitor:getTotalExecutionTime()
    local total = 0
    for _, record in ipairs(self.metrics.scriptExecutionTimes) do
        total = total + record.duration
    end
    return total
end

function PerformanceMonitor:getTotalWaitTime()
    local total = 0
    for _, record in ipairs(self.metrics.waitTimes) do
        total = total + record.duration
    end
    return total
end

function PerformanceMonitor:getMemoryDelta()
    if #self.metrics.memorySnapshots < 2 then
        return 0
    end
    
    local first = self.metrics.memorySnapshots[1]
    local last = self.metrics.memorySnapshots[#self.metrics.memorySnapshots]
    
    return last.memoryKB - first.memoryKB
end

function PerformanceMonitor:generateReport()
    if not self.enabled then
        return { enabled = false }
    end
    
    return {
        enabled = true,
        totalDuration = self.metrics.totalDuration,
        fetchTime = self:getTotalFetchTime(),
        executionTime = self:getTotalExecutionTime(),
        waitTime = self:getTotalWaitTime(),
        overhead = self.metrics.totalDuration - self:getTotalFetchTime() - self:getTotalExecutionTime() - self:getTotalWaitTime(),
        memoryDelta = self:getMemoryDelta(),
        fetchCount = #self.metrics.scriptFetchTimes,
        executionCount = #self.metrics.scriptExecutionTimes,
        memorySnapshots = #self.metrics.memorySnapshots
    }
end

function PerformanceMonitor:printReport()
    if not self.enabled then return end
    
    local report = self:generateReport()
    
    self.logger:info("=== PERFORMANCE REPORT ===")
    self.logger:info("Total Duration: " .. string.format("%.3f", report.totalDuration) .. "s")
    self.logger:info("Fetch Time: " .. string.format("%.3f", report.fetchTime) .. "s")
    self.logger:info("Execution Time: " .. string.format("%.3f", report.executionTime) .. "s")
    self.logger:info("Wait Time: " .. string.format("%.3f", report.waitTime) .. "s")
    self.logger:info("Overhead: " .. string.format("%.3f", report.overhead) .. "s")
    self.logger:info("Memory Delta: " .. Utilities.formatBytes(report.memoryDelta * 1024))
    self.logger:info("=========================")
end

function PerformanceMonitor:reset()
    self.metrics = {
        startTime = tick(),
        endTime = nil,
        totalDuration = 0,
        scriptFetchTimes = {},
        scriptExecutionTimes = {},
        waitTimes = {},
        memorySnapshots = {},
        customMetrics = {}
    }
    self.logger:debug("Performance metrics reset")
end

-- ============================================================================
-- SECTION 9: SCRIPT REGISTRY
-- ============================================================================

local ScriptRegistry = {}
ScriptRegistry.__index = ScriptRegistry

function ScriptRegistry.new(logger, config)
    local self = setmetatable({}, ScriptRegistry)
    
    self.logger = logger
    self.config = config or {}
    self.scripts = {}
    self.loadOrder = {}
    
    -- Register configured scripts
    self:registerFromConfig()
    
    return self
end

function ScriptRegistry:registerFromConfig()
    self.logger:debug("Registering scripts from configuration...")
    
    if self.config.SCRIPTS then
        for key, scriptConfig in pairs(self.config.SCRIPTS) do
            self:register(key, scriptConfig)
        end
    end
    
    -- Sort by priority
    self:sortByPriority()
    
    self.logger:info("Registered " .. #self.loadOrder .. " scripts")
end

function ScriptRegistry:register(key, scriptConfig)
    self.scripts[key] = {
        config = scriptConfig,
        key = key,
        registeredAt = Utilities.getCurrentTimestamp(),
        status = "registered",
        lastExecuted = nil,
        executionCount = 0
    }
    
    table.insert(self.loadOrder, key)
    
    self.logger:debug("Script registered: " .. scriptConfig.NAME .. " (key: " .. key .. ")")
end

function ScriptRegistry:unregister(key)
    if self.scripts[key] then
        self.scripts[key] = nil
        
        for i, k in ipairs(self.loadOrder) do
            if k == key then
                table.remove(self.loadOrder, i)
                break
            end
        end
        
        self.logger:debug("Script unregistered: " .. key)
        return true
    end
    
    return false
end

function ScriptRegistry:getScript(key)
    return self.scripts[key]
end

function ScriptRegistry:getScriptConfig(key)
    local script = self.scripts[key]
    return script and script.config or nil
end

function ScriptRegistry:getAllScripts()
    return self.scripts
end

function ScriptRegistry:getLoadOrder()
    return self.loadOrder
end

function ScriptRegistry:getEnabledScripts()
    local enabled = {}
    for _, key in ipairs(self.loadOrder) do
        local script = self.scripts[key]
        if script and script.config.ENABLED then
            table.insert(enabled, key)
        end
    end
    return enabled
end

function ScriptRegistry:sortByPriority()
    table.sort(self.loadOrder, function(a, b)
        local scriptA = self.scripts[a]
        local scriptB = self.scripts[b]
        
        if scriptA and scriptB then
            return (scriptA.config.PRIORITY or 999) < (scriptB.config.PRIORITY or 999)
        end
        return false
    end)
    
    self.logger:debug("Scripts sorted by priority")
end

function ScriptRegistry:updateStatus(key, status)
    if self.scripts[key] then
        self.scripts[key].status = status
        self.logger:debug("Script status updated: " .. key .. " -> " .. status)
    end
end

function ScriptRegistry:recordExecution(key)
    if self.scripts[key] then
        self.scripts[key].lastExecuted = Utilities.getCurrentTimestamp()
        self.scripts[key].executionCount = self.scripts[key].executionCount + 1
        self.scripts[key].status = "executed"
    end
end

function ScriptRegistry:getScriptCount()
    return Utilities.getTableLength(self.scripts)
end

function ScriptRegistry:getEnabledCount()
    return #self:getEnabledScripts()
end

function ScriptRegistry:generateReport()
    local report = {
        totalScripts = self:getScriptCount(),
        enabledScripts = self:getEnabledCount(),
        loadOrder = self:getLoadOrder(),
        scripts = {}
    }
    
    for key, script in pairs(self.scripts) do
        table.insert(report.scripts, {
            key = key,
            name = script.config.NAME,
            enabled = script.config.ENABLED,
            priority = script.config.PRIORITY,
            status = script.status,
            executionCount = script.executionCount,
            lastExecuted = script.lastExecuted
        })
    end
    
    return report
end

function ScriptRegistry:enable(key)
    if self.scripts[key] then
        self.scripts[key].config.ENABLED = true
        self.logger:info("Script enabled: " .. key)
    end
end

function ScriptRegistry:disable(key)
    if self.scripts[key] then
        self.scripts[key].config.ENABLED = false
        self.logger:info("Script disabled: " .. key)
    end
end

function ScriptRegistry:setPriority(key, priority)
    if self.scripts[key] then
        self.scripts[key].config.PRIORITY = priority
        self:sortByPriority()
        self.logger:info("Script priority updated: " .. key .. " -> " .. priority)
    end
end

-- ============================================================================
-- SECTION 10: MAIN EXECUTION PIPELINE
-- ============================================================================

local ExecutionPipeline = {}
ExecutionPipeline.__index = ExecutionPipeline

ExecutionPipeline.STATES = {
    IDLE = "IDLE",
    INITIALIZING = "INITIALIZING",
    RUNNING = "RUNNING",
    WAITING = "WAITING",
    COMPLETED = "COMPLETED",
    FAILED = "FAILED",
    CANCELLED = "CANCELLED"
}

function ExecutionPipeline.new(config)
    local self = setmetatable({}, ExecutionPipeline)
    
    self.config = config or CONFIG
    self.state = ExecutionPipeline.STATES.IDLE
    self.startTime = nil
    self.endTime = nil
    
    -- Initialize components
    self.logger = Logger.new(self.config.LOGGING)
    self.errorHandler = ErrorHandler.new(self.logger, self.config.ERROR_HANDLING)
    self.httpHandler = HttpHandler.new(self.logger, self.config.SCRIPTS.PRIMARY)
    self.scriptExecutor = ScriptExecutor.new(self.logger, self.httpHandler, self.config)
    self.timerManager = TimerManager.new(self.logger, self.config.TIMING)
    self.performanceMonitor = PerformanceMonitor.new(self.logger, self.config.PERFORMANCE)
    self.scriptRegistry = ScriptRegistry.new(self.logger, self.config)
    
    return self
end

function ExecutionPipeline:getState()
    return self.state
end

function ExecutionPipeline:setState(state)
    self.logger:debug("Pipeline state: " .. self.state .. " -> " .. state)
    self.state = state
end

function ExecutionPipeline:initialize()
    self.logger:info("Initializing execution pipeline...")
    self:setState(ExecutionPipeline.STATES.INITIALIZING)
    
    self.startTime = tick()
    
    -- Start performance monitoring
    self.performanceMonitor:start()
    
    -- Log environment info
    local envInfo = Utilities.getEnvironmentInfo()
    self.logger:info("Platform: " .. envInfo.platform)
    self.logger:info("Executor: " .. envInfo.executor)
    self.logger:info("Session ID: " .. envInfo.uniqueId)
    
    -- Check prerequisites
    local prerequisitesMet = self:checkPrerequisites()
    if not prerequisitesMet then
        self.logger:error("Prerequisites not met - aborting")
        self:setState(ExecutionPipeline.STATES.FAILED)
        return false
    end
    
    self.logger:info("Pipeline initialized successfully")
    return true
end

function ExecutionPipeline:checkPrerequisites()
    self.logger:debug("Checking prerequisites...")
    
    -- Check HTTP availability
    if self.config.SAFETY.CHECK_HTTP_AVAILABILITY then
        if not self.httpHandler:isHTTPAvailable() then
            self.errorHandler:handleError(
                ErrorHandler.ERROR_TYPES.NETWORK,
                "HTTP service not available",
                ErrorHandler.SEVERITY.CRITICAL
            )
            return false
        end
    end
    
    -- Check game context
    if self.config.SAFETY.REQUIRE_GAME_CONTEXT then
        if not game then
            self.errorHandler:handleError(
                ErrorHandler.ERROR_TYPES.VALIDATION,
                "Game context not available",
                ErrorHandler.SEVERITY.CRITICAL
            )
            return false
        end
    end
    
    -- Check if any scripts are enabled
    local enabledScripts = self.scriptRegistry:getEnabledScripts()
    if #enabledScripts == 0 then
        self.logger:warning("No enabled scripts found")
        return false
    end
    
    self.logger:info("All prerequisites met")
    return true
end

function ExecutionPipeline:executeScriptByKey(key)
    local scriptConfig = self.scriptRegistry:getScriptConfig(key)
    
    if not scriptConfig then
        self.logger:error("Script not found: " .. key)
        return false
    end
    
    if not scriptConfig.ENABLED then
        self.logger:warning("Script disabled: " .. key)
        return false
    end
    
    self.scriptRegistry:updateStatus(key, "executing")
    
    local fetchStartTime = tick()
    local success, message = self.scriptExecutor:loadAndExecute(scriptConfig)
    local fetchEndTime = tick()
    
    -- Record performance
    self.performanceMonitor:recordFetchTime(scriptConfig.URL, fetchEndTime - fetchStartTime)
    self.performanceMonitor:recordExecutionTime(scriptConfig.NAME, fetchEndTime - fetchStartTime)
    
    if success then
        self.scriptRegistry:recordExecution(key)
        self.scriptRegistry:updateStatus(key, "completed")
    else
        self.scriptRegistry:updateStatus(key, "failed")
        
        self.errorHandler:handleError(
            ErrorHandler.ERROR_TYPES.EXECUTION,
            "Script execution failed: " .. scriptConfig.NAME .. " - " .. tostring(message),
            ErrorHandler.SEVERITY.HIGH
        )
    end
    
    return success
end

function ExecutionPipeline:executeAll()
    self.logger:info("Starting execution of all scripts...")
    self:setState(ExecutionPipeline.STATES.RUNNING)
    
    local enabledScripts = self.scriptRegistry:getEnabledScripts()
    local results = {}
    
    for i, key in ipairs(enabledScripts) do
        self.logger:info("Executing script " .. i .. "/" .. #enabledScripts .. ": " .. key)
        
        local success = self:executeScriptByKey(key)
        results[key] = success
        
        -- Wait between scripts
        if i < #enabledScripts then
            self.logger:debug("Waiting between scripts...")
            self.timerManager:wait(self.config.TIMING.BETWEEN_SCRIPTS_WAIT, "Between scripts")
        end
    end
    
    return results
end

function ExecutionPipeline:run()
    self.logger:info("========================================")
    self.logger:info("ECLIPSE DUAL SCRIPT LOADER - STARTING")
    self.logger:info("========================================")
    
    -- Initialize
    if not self:initialize() then
        self.logger:error("Pipeline initialization failed")
        self:setState(ExecutionPipeline.STATES.FAILED)
        return false
    end
    
    -- Wait initial delay
    self.logger:info("Waiting " .. self.config.TIMING.INITIAL_DELAY .. "s before execution...")
    self:setState(ExecutionPipeline.STATES.WAITING)
    
    self.timerManager:waitWithProgress(
        self.config.TIMING.INITIAL_DELAY,
        "Initial delay",
        1
    )
    
    -- Pre-execution wait
    if self.config.TIMING.PRE_EXECUTION_WAIT > 0 then
        self.timerManager:wait(
            self.config.TIMING.PRE_EXECUTION_WAIT,
            "Pre-execution preparation"
        )
    end
    
    -- Execute scripts
    local results = self:executeAll()
    
    -- Post-execution wait
    if self.config.TIMING.POST_EXECUTION_WAIT > 0 then
        self.timerManager:wait(
            self.config.TIMING.POST_EXECUTION_WAIT,
            "Post-execution cleanup"
        )
    end
    
    -- Check for critical errors
    if self.errorHandler:hasCriticalErrors() and self.config.ERROR_HANDLING.THROW_ON_FINAL_FAILURE then
        self.logger:critical("Critical errors detected - throwing error")
        self.errorHandler:throwIfCritical()
    end
    
    -- Finalize
    self:finalize(results)
    
    return true
end

function ExecutionPipeline:finalize(results)
    self.endTime = tick()
    self:setState(ExecutionPipeline.STATES.COMPLETED)
    
    -- Stop performance monitoring
    self.performanceMonitor:stop()
    
    -- Generate reports
    self.logger:info("========================================")
    self.logger:info("EXECUTION COMPLETE - FINAL REPORT")
    self.logger:info("========================================")
    
    -- Logger report
    local loggerReport = self.logger:generateReport()
    self.logger:info("Log entries: " .. loggerReport.totalEntries)
    self.logger:info("Uptime: " .. string.format("%.3f", loggerReport.uptime) .. "s")
    
    -- Script execution report
    local execReport = self.scriptExecutor:generateExecutionReport()
    self.logger:info("Scripts executed: " .. execReport.totalExecutions)
    self.logger:info("Total execution time: " .. string.format("%.3f", execReport.totalExecutionTime) .. "s")
    
    -- Performance report
    if self.config.PERFORMANCE.REPORT_ON_COMPLETE then
        self.performanceMonitor:printReport()
    end
    
    -- Error report
    local errorReport = self.errorHandler:generateErrorReport()
    if errorReport.totalErrors > 0 then
        self.logger:warning("Errors encountered: " .. errorReport.totalErrors)
        
        if errorReport.bySeverity.CRITICAL > 0 then
            self.logger:critical("Critical errors: " .. errorReport.bySeverity.CRITICAL)
        end
    else
        self.logger:info("No errors encountered")
    end
    
    -- HTTP stats
    local httpStats = self.httpHandler:getStats()
    self.logger:info("HTTP requests: " .. httpStats.requestCount)
    self.logger:info("Data received: " .. Utilities.formatBytes(httpStats.totalBytesReceived))
    
    -- Timing summary
    local totalDuration = self.endTime - self.startTime
    self.logger:info("Total duration: " .. string.format("%.3f", totalDuration) .. "s")
    
    -- Timer stats
    self.logger:info("Total wait time: " .. string.format("%.3f", self.timerManager:getTotalWaitTime()) .. "s")
    
    self.logger:info("========================================")
    self.logger:info("LOADER FINISHED SUCCESSFULLY")
    self.logger:info("========================================")
end

function ExecutionPipeline:cancel()
    self.logger:warning("Pipeline cancelled by user")
    self:setState(ExecutionPipeline.STATES.CANCELLED)
end

function ExecutionPipeline:getDuration()
    if self.startTime then
        local endTime = self.endTime or tick()
        return endTime - self.startTime
    end
    return 0
end

function ExecutionPipeline:generateFullReport()
    return {
        state = self.state,
        duration = self:getDuration(),
        logger = self.logger:generateReport(),
        performance = self.performanceMonitor:generateReport(),
        errors = self.errorHandler:generateErrorReport(),
        scripts = self.scriptRegistry:generateReport(),
        execution = self.scriptExecutor:generateExecutionReport(),
        http = self.httpHandler:getStats()
    }
end

-- ============================================================================
-- SECTION 11: CLEANUP HANDLER
-- ============================================================================

local CleanupHandler = {}
CleanupHandler.__index = CleanupHandler

function CleanupHandler.new(pipeline)
    local self = setmetatable({}, CleanupHandler)
    
    self.pipeline = pipeline
    self.cleanupTasks = {}
    self.executed = false
    
    return self
end

function CleanupHandler:registerCleanupTask(name, taskFunction, priority)
    table.insert(self.cleanupTasks, {
        name = name,
        func = taskFunction,
        priority = priority or 100,
        executed = false
    })
    
    -- Sort by priority
    table.sort(self.cleanupTasks, function(a, b)
        return a.priority < b.priority
    end)
end

function CleanupHandler:execute()
    if self.executed then
        return
    end
    
    self.executed = true
    
    self.pipeline.logger:info("Executing cleanup tasks...")
    
    for _, task in ipairs(self.cleanupTasks) do
        if not task.executed then
            self.pipeline.logger:debug("Cleanup: " .. task.name)
            
            local success, result = pcall(task.func)
            
            if success then
                task.executed = true
            else
                self.pipeline.logger:warning("Cleanup task failed: " .. task.name .. " - " .. tostring(result))
            end
        end
    end
    
    self.pipeline.logger:info("Cleanup complete")
end

function CleanupHandler:reset()
    self.executed = false
    for _, task in ipairs(self.cleanupTasks) do
        task.executed = false
    end
end

