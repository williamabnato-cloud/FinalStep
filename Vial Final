local Utilities = {}

function Utilities.deepCopy(original)
    local copy
    if type(original) == "table" then
        copy = {}
        for key, value in pairs(original) do
            copy[Utilities.deepCopy(key)] = Utilities.deepCopy(value)
        end
    else
        copy = original
    end
    return copy
end

function Utilities.mergeTables(base, override)
    local result = Utilities.deepCopy(base)
    for key, value in pairs(override) do
        if type(value) == "table" and type(result[key]) == "table" then
            result[key] = Utilities.mergeTables(result[key], value)
        else
            result[key] = Utilities.deepCopy(value)
        end
    end
    return result
end

function Utilities.tableContains(table, element)
    for _, value in pairs(table) do
        if value == element then
            return true
        end
    end
    return false
end

function Utilities.getTableLength(t)
    local count = 0
    for _ in pairs(t) do
        count = count + 1
    end
    return count
end

function Utilities.isStringEmpty(str)
    return str == nil or str == "" or str:match("^%s*$") ~= nil
end

function Utilities.trimString(str)
    if str == nil then return nil end
    return str:match("^%s*(.-)%s*$")
end

function Utilities.isValidURL(url)
    if Utilities.isStringEmpty(url) then
        return false
    end
    local pattern = "^https?://[%w%.%-]+%.%w+/"
    return url:match(pattern) ~= nil
end

function Utilities.getCurrentTimestamp()
    return os.time()
end

function Utilities.getFormattedTimestamp()
    local timestamp = os.date("*t")
    return string.format(
        "%04d-%02d-%02d %02d:%02d:%02d",
        timestamp.year,
        timestamp.month,
        timestamp.day,
        timestamp.hour,
        timestamp.min,
        timestamp.sec
    )
end

function Utilities.generateUniqueId()
    local chars = "abcdefghijklmnopqrstuvwxyz0123456789"
    local id = ""
    for i = 1, 16 do
        local rand = math.random(1, #chars)
        id = id .. chars:sub(rand, rand)
    end
    return id
end

function Utilities.safeCall(func, ...)
    local success, result = pcall(func, ...)
    return success, result
end

function Utilities.waitForCondition(condition, timeout, checkInterval)
    local startTime = tick()
    local interval = checkInterval or 0.1
    
    while tick() - startTime < (timeout or 10) do
        if condition() then
            return true
        end
        task.wait(interval)
    end
    return false
end

function Utilities.retryOperation(operation, maxRetries, delay, backoff)
    local retries = 0
    local currentDelay = delay or 1
    local backoffMultiplier = backoff or 1
    
    while retries < maxRetries do
        local success, result = pcall(operation)
        if success then
            return true, result
        end
        
        retries = retries + 1
        if retries < maxRetries then
            task.wait(currentDelay)
            currentDelay = currentDelay * backoffMultiplier
        end
    end
    
    return false, nil
end

function Utilities.formatBytes(bytes)
    if bytes < 1024 then
        return string.format("%.2f B", bytes)
    elseif bytes < 1024 * 1024 then
        return string.format("%.2f KB", bytes / 1024)
    else
        return string.format("%.2f MB", bytes / (1024 * 1024))
    end
end

function Utilities.getEnvironmentInfo()
    return {
        platform = "Roblox",
        executor = identifyexecutor and identifyexecutor() or "Unknown",
        timestamp = Utilities.getFormattedTimestamp(),
        uniqueId = Utilities.generateUniqueId()
    }
end

