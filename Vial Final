local ScriptExecutor = {}
ScriptExecutor.__index = ScriptExecutor

function ScriptExecutor.new(logger, httpHandler, config)
    local self = setmetatable({}, ScriptExecutor)
    
    self.logger = logger
    self.httpHandler = httpHandler
    self.config = config or {}
    self.executedScripts = {}
    self.executionHistory = {}
    self.currentScript = nil
    
    return self
end

function ScriptExecutor:validateScriptContent(content)
    if Utilities.isStringEmpty(content) then
        self.logger:error("Script content is empty")
        return false, "Empty content"
    end
    
    -- Check script size
    if self.config.SAFETY and self.config.SAFETY.MAX_SCRIPT_SIZE then
        if #content > self.config.SAFETY.MAX_SCRIPT_SIZE then
            self.logger:error("Script exceeds maximum size")
            return false, "Script too large"
        end
    end
    
    -- Basic content validation
    if content:match("require%s*%(.*%)") and not content:match("game:GetService") then
        self.logger:warning("Script contains require - potential external dependency")
    end
    
    return true, "Valid"
end

function ScriptExecutor:fetchScript(scriptConfig)
    self.logger:info("Preparing to fetch script: " .. scriptConfig.NAME)
    
    if not scriptConfig.ENABLED then
        self.logger:warning("Script is disabled: " .. scriptConfig.NAME)
        return false, nil, "Script disabled"
    end
    
    local success, content, message = self.httpHandler:fetch(scriptConfig.URL, {
        timeout = scriptConfig.TIMEOUT,
        retries = scriptConfig.RETRY_COUNT,
        retryDelay = scriptConfig.RETRY_DELAY
    })
    
    if not success then
        self.logger:error("Failed to fetch script: " .. scriptConfig.NAME .. " - " .. tostring(message))
        return false, nil, message
    end
    
    -- Validate content
    local isValid, validationMessage = self:validateScriptContent(content)
    if not isValid then
        self.logger:error("Script validation failed: " .. scriptConfig.NAME .. " - " .. validationMessage)
        return false, nil, validationMessage
    end
    
    self.logger:info("Script fetched and validated: " .. scriptConfig.NAME)
    return true, content, "Success"
end

function ScriptExecutor:compileScript(content)
    self.logger:debug("Compiling script...")
    
    local compileSuccess, compiledFunction = pcall(function()
        return loadstring(content)
    end)
    
    if not compileSuccess then
        self.logger:error("Script compilation failed: " .. tostring(compiledFunction))
        return false, nil, tostring(compiledFunction)
    end
    
    if compiledFunction == nil then
        self.logger:error("Compiled function is nil")
        return false, nil, "Nil compiled function"
    end
    
    self.logger:debug("Script compiled successfully")
    return true, compiledFunction, "Success"
end

function ScriptExecutor:executeScript(compiledFunction, scriptName)
    self.logger:info("Executing script: " .. scriptName)
    
    local startTime = tick()
    
    -- Set current script reference
    self.currentScript = scriptName
    
    local success, result = pcall(compiledFunction)
    
    local endTime = tick()
    local executionTime = endTime - startTime
    
    -- Record execution
    local executionRecord = {
        name = scriptName,
        startTime = startTime,
        endTime = endTime,
        executionTime = executionTime,
        success = success,
        result = result,
        timestamp = Utilities.getFormattedTimestamp()
    }
    
    table.insert(self.executionHistory, executionRecord)
    
    if success then
        self.logger:info("Script executed successfully: " .. scriptName)
        self.logger:debug("Execution time: " .. string.format("%.3f", executionTime) .. "s")
        
        table.insert(self.executedScripts, {
            name = scriptName,
            timestamp = Utilities.getCurrentTimestamp(),
            executionTime = executionTime
        })
    else
        self.logger:error("Script execution failed: " .. scriptName .. " - " .. tostring(result))
    end
    
    self.currentScript = nil
    
    return success, result, executionTime
end

function ScriptExecutor:loadAndExecute(scriptConfig)
    self.logger:info("Starting load-and-execute pipeline for: " .. scriptConfig.NAME)
    
    -- Fetch
    local fetchSuccess, content, fetchMessage = self:fetchScript(scriptConfig)
    if not fetchSuccess then
        return false, "Fetch failed: " .. tostring(fetchMessage)
    end
    
    -- Compile
    local compileSuccess, compiledFunction, compileMessage = self:compileScript(content)
    if not compileSuccess then
        return false, "Compile failed: " .. tostring(compileMessage)
    end
    
    -- Execute
    local execSuccess, execResult, execTime = self:executeScript(compiledFunction, scriptConfig.NAME)
    if not execSuccess then
        return false, "Execution failed: " .. tostring(execResult)
    end
    
    self.logger:info("Pipeline complete for: " .. scriptConfig.NAME)
    return true, "Success"
end

function ScriptExecutor:getExecutedScripts()
    return self.executedScripts
end

function ScriptExecutor:getExecutionHistory()
    return self.executionHistory
end

function ScriptExecutor:getExecutionCount()
    return #self.executedScripts
end

function ScriptExecutor:getCurrentScript()
    return self.currentScript
end

function ScriptExecutor:getTotalExecutionTime()
    local totalTime = 0
    for _, record in ipairs(self.executionHistory) do
        totalTime = totalTime + (record.executionTime or 0)
    end
    return totalTime
end

function ScriptExecutor:generateExecutionReport()
    return {
        totalExecutions = self:getExecutionCount(),
        totalExecutionTime = self:getTotalExecutionTime(),
        averageExecutionTime = self:getExecutionCount() > 0 and (self:getTotalExecutionTime() / self:getExecutionCount()) or 0,
        history = self:getExecutionHistory()
    }
end

function ScriptExecutor:clearHistory()
    self.executedScripts = {}
    self.executionHistory = {}
    self.logger:debug("Execution history cleared")
end

