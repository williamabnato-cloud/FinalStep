local TimerManager = {}
TimerManager.__index = TimerManager

function TimerManager.new(logger, config)
    local self = setmetatable({}, TimerManager)
    
    self.logger = logger
    self.config = config or {}
    self.timers = {}
    self.activeTimers = {}
    self.totalWaitTime = 0
    
    return self
end

function TimerManager:createTimer(name, duration, callback)
    local timer = {
        name = name,
        duration = duration,
        callback = callback,
        startTime = nil,
        endTime = nil,
        status = "pending",
        id = Utilities.generateUniqueId()
    }
    
    self.timers[name] = timer
    self.logger:debug("Timer created: " .. name .. " (" .. duration .. "s)")
    
    return timer
end

function TimerManager:startTimer(name)
    local timer = self.timers[name]
    if not timer then
        self.logger:error("Timer not found: " .. name)
        return false
    end
    
    timer.startTime = tick()
    timer.status = "running"
    table.insert(self.activeTimers, name)
    
    self.logger:debug("Timer started: " .. name)
    return true
end

function TimerManager:stopTimer(name)
    local timer = self.timers[name]
    if not timer then
        self.logger:error("Timer not found: " .. name)
        return false
    end
    
    timer.endTime = tick()
    timer.status = "completed"
    
    -- Remove from active timers
    for i, activeName in ipairs(self.activeTimers) do
        if activeName == name then
            table.remove(self.activeTimers, i)
            break
        end
    end
    
    self.logger:debug("Timer stopped: " .. name)
    return true
end

function TimerManager:wait(duration, description)
    description = description or "unnamed wait"
    
    self.logger:debug("Waiting " .. duration .. "s - " .. description)
    
    local startTime = tick()
    task.wait(duration)
    local endTime = tick()
    
    local actualDuration = endTime - startTime
    self.totalWaitTime = self.totalWaitTime + actualDuration
    
    self.logger:debug("Wait complete - " .. description .. " (actual: " .. string.format("%.3f", actualDuration) .. "s)")
    
    return actualDuration
end

function TimerManager:waitWithProgress(duration, description, updateInterval)
    description = description or "unnamed wait"
    updateInterval = updateInterval or 1
    
    self.logger:info("Waiting " .. duration .. "s - " .. description)
    
    local startTime = tick()
    local elapsed = 0
    
    while elapsed < duration do
        local remaining = duration - elapsed
        local waitTime = math.min(updateInterval, remaining)
        
        task.wait(waitTime)
        elapsed = tick() - startTime
        
        if remaining > updateInterval then
            self.logger:debug(string.format("%.1fs remaining...", remaining))
        end
    end
    
    self.totalWaitTime = self.totalWaitTime + duration
    
    self.logger:info("Wait complete - " .. description)
    return duration
end

function TimerManager:executeAfterDelay(delay, callback, description)
    description = description or "delayed execution"
    
    self.logger:debug("Scheduling execution after " .. delay .. "s - " .. description)
    
    task.delay(delay, function()
        self.logger:debug("Executing delayed task - " .. description)
        local success, result = pcall(callback)
        
        if not success then
            self.logger:error("Delayed execution failed - " .. description .. ": " .. tostring(result))
        end
    end)
end

function TimerManager:getTotalWaitTime()
    return self.totalWaitTime
end

function TimerManager:getActiveTimers()
    return self.activeTimers
end

function TimerManager:getTimerInfo(name)
    return self.timers[name]
end

function TimerManager:reset()
    self.timers = {}
    self.activeTimers = {}
    self.totalWaitTime = 0
    self.logger:debug("Timer manager reset")
end

